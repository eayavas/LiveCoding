setcps (150/4/60)

let cutoff = pF "cutoff"
    res = pF "res"
    drive = pF "drive"
    wobble = pF "wobble"

do
  d1 -- drums
    $ s "[kk yhh <ycp!3 ycp*5> yhh <kk [ysd kk]> kk ycp <- kk>]"
    # room 0.3 # size 0.7
  d2
    $ fast "<8 4> <2!3 4>"
    $ s "cyber_bass*4"
    # note "<12 12 15 12> <[0 12] [7]>"
    # cutoff 3500
    # drive 5
    # res "3 0.5 0.3 5"
    # sustain 0.4
    # gain 0.6
  d3 -- Alien Sounds
    $ s "[<-!6 alienic1:1> <alienic1 alienic1:2>]*4"
    # gain 0.7
    # room 0.5 # size 0.87
    resetCycles 

hush
