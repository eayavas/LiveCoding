let detune = pF "detune"
    drive = pF "drive"
    subamp = pF "subamp"

do
  d1 $ fast 2 $ note (scale "phyrigian" "0 1 1 3 0 2 3 1") |+ note "f3"
    # drive 1.4
    # subamp 0.8
    # s "ysaw"
  resetCycles

d2 -- KICK
  $ sound "bd*4" # n "1"

d3 -- SNARE
  $ sound "[- cp]*2" # n "3"
  # gain 0.8

d4
  $ slow 2 $ note (scale "phyrigian" "[0 ~ 1 ~] [3 ~ 2 0]") |+ note "f3"
  # s "superhex"
  # octave 5
  # shape 0.7
  # lpf (range 1500 8000 $ slow 3 sine)
  # hpf 500
  # delay 0.8
  # delaytime "e"
  # delayfeedback 0.6
  # room 0.5
  # sz 0.9
  # gain 0.4
