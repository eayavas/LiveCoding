setcps(128/60/4)

let kit name pat = s (fmap (name ++) pat)

jumpIn 1 0 $ stack [
   mask "<1!7 0>" $ stack [
       kit "LinnDrum" "[bd bd bd bd]",
       kit "LinnDrum" "- sd - sd" # gain 0.7
   ],
   kit "LinnDrum" "[- - - [- cp - <- [- cp]>]]/2"# gain 0.7
   ]
  # room 0.1
  # shape 0.6

d3 $ fast 4 $ kit "LinnDrum" "hh:2!2 hh:1 hh:2"
  # shape 0.3
  # gain 0.7
  # room 0.1

do
  jumpIn 7 0 $ note (scale "minor" "[0 <1 0!3> <0 5> <0!3 4>]*2" |+ "a4")
    # s "junobass"
    # gain 0.9
  jumpIn 2 0 $ whenmod 8 7
    (const $ fast "2" $ kit "LinnDrum" "[lt <- lt>] [<- rim> ht] - <[rim -] [mt sd]>" # gain 0.7)
    $ kit "LinnDrum" "- <lt [- mt]> - rim" # gain 0.7

do
  d8 $ slow 4 $ note (scale "minor" "<[0 4 5 3] [2 3 1 0]>" |+ "a4") # s "midi" # midichan 0 --juno 60
  resetCycles


  
hush